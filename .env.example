APP_NAME=Learner Memory & Persona Intelligence System
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Defaults on Windows: %LOCALAPPDATA%/Studyfolio/{sqlite,chroma}.
# Override with a local folder if needed. Keep private data outside synced folders.
# APP_DATA_DIR=C:/StudyfolioData
# DATABASE_URL=sqlite:///C:/StudyfolioData/sqlite/learner_memory.db
# CHROMA_PERSIST_DIR=C:/StudyfolioData/chroma
DEFAULT_TIMEZONE=Asia/Kolkata
# Set a LiteLLM provider/model identifier you have verified with your provider.
LLM_ENABLED=false
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
# The model is opened with local_files_only. Install weights separately.
VECTOR_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
SHORT_TERM_MAX_MESSAGES=30
SHORT_TERM_MAX_TOKENS=4000
SHORT_TERM_HOURS=24
MEMORY_REFLECTION_MESSAGE_THRESHOLD=8
CALENDAR_REQUIRE_CONFIRMATION=true
CALENDAR_AUTO_CONFIRM_EXPLICIT_COMMANDS=true
LOG_LEVEL=INFO
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
RRF_K=60
SOURCE_OCR=false
# Optional: allow selected narrative passages to reach the configured model.
SOURCE_LLM_ENABLED=false
